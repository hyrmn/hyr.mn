<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <meta name="generator" content="{{ eleventy.generator }}">

    <link rel="preload" href="/css/site.css" as="style">
    <link rel="stylesheet" href="/css/site.css">
    <link rel="stylesheet" href="/css/prism.css">

    <link rel="shortcut icon" href="/favicon.ico" />

    <link rel="alternate" type="application/rss+xml" title="RSS Feed" href="/feed.xml"/>
    <title>{{ title }}</title>

    <script defer src="https://kit.fontawesome.com/1ac284761b.js" crossorigin="anonymous"></script>
  </head>
  <body class="bg-white dark:bg-stone-950 text-stone-800 dark:text-stone-200">

    <header class="max-w-3xl mx-auto px-6 py-6 border-b border-stone-200 dark:border-stone-800 print:hidden">
        <div class="flex items-center justify-between">
            <span class="font-bold text-xl tracking-tight text-stone-900 dark:text-stone-100">Ben Hyrman</span>

            <nav>
                <ul class="flex items-center gap-4">
                  <li><a class="text-sm font-medium text-stone-500 dark:text-stone-400 hover:text-stone-900 dark:hover:text-stone-100 transition-colors {% if page.url === '/' %}text-stone-900 dark:text-stone-100{% endif %}" href="/">Home</a></li>
                  <li><a class="text-sm font-medium text-stone-500 dark:text-stone-400 hover:text-stone-900 dark:hover:text-stone-100 transition-colors {% if page.url === '/blog/' %}text-stone-900 dark:text-stone-100{% endif %}" href="/blog/">Blog</a></li>
                  <li><a class="text-sm font-medium text-stone-500 dark:text-stone-400 hover:text-stone-900 dark:hover:text-stone-100 transition-colors {% if page.url === '/projects/' %}text-stone-900 dark:text-stone-100{% endif %}" href="/projects/">Projects</a></li>
                </ul>
            </nav>

            <div class="flex items-center gap-2">
              <a href="https://github.com/hyrmn" title="GitHub" class="text-stone-400 hover:text-stone-700 dark:hover:text-stone-200 transition-colors" target="offsite">
                  <i class="fa-brands fa-github"></i>
              </a>
              <a href="https://linkedin.com/in/benhyrman" title="LinkedIn" class="text-stone-400 hover:text-stone-700 dark:hover:text-stone-200 transition-colors" target="offsite">
                  <i class="fa-brands fa-linkedin"></i>
              </a>
              <a href="https://www.flickr.com/photos/benhyr" title="Flickr" class="text-stone-400 hover:text-stone-700 dark:hover:text-stone-200 transition-colors" target="offsite">
                  <i class="fa-brands fa-flickr"></i>
              </a>
              <a href="/feed.xml" title="RSS" class="text-stone-400 hover:text-stone-700 dark:hover:text-stone-200 transition-colors">
                  <i class="fa-solid fa-rss"></i>
              </a>
            </div>
        </div>
    </header>

    <div class="max-w-3xl mx-auto px-6 py-8">
      <main>
        {{ content | safe }}
      </main>
    </div>

    <footer class="max-w-3xl mx-auto px-6 pb-8 border-t border-stone-200 dark:border-stone-800 print:hidden">
        <p class="text-xs text-stone-400 dark:text-stone-600 mt-6">&copy; Ben Hyrman &middot; <a href="https://github.com/hyrmn/hyr.mn" class="hover:text-stone-600 dark:hover:text-stone-400">Source</a> &middot; <a rel="license" href="http://creativecommons.org/licenses/by-sa/4.0/" class="hover:text-stone-600 dark:hover:text-stone-400">CC BY-SA 4.0</a></p>
    </footer>

  </body>
</html>
